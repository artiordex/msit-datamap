# Kestra API
KESTRA_BASE_URL=http://localhost:8080
KESTRA_TENANT=main
KESTRA_NAMESPACE=mfds.usecase
KESTRA_FLOW_ID=food_safety_usecase_pipeline

# Optional authentication
# KESTRA_USERNAME=admin@kestra.io
# KESTRA_PASSWORD=kestra
# KESTRA_API_TOKEN=

# Local project defaults
PROJECT_DIR=C:/식약처/활용사례
INPUT_FILE=활용사례_자동화_검색.xlsx
RUN_MODE=incremental

# OpenAI web search integration
# OpenAI API data is not used to train OpenAI models unless you opt in.
# Keep this value only in .env, never in Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GPT_SEARCH_MODE=dry-run
GPT_SEARCH_MAX_ROWS=10

# Browser search integration without OpenAI API billing.
# This uses Playwright against public search pages, so it can be affected by captcha/rate limits.
BROWSER_SEARCH_ENGINE=naver
BROWSER_SEARCH_MAX_ROWS=10
BROWSER_SEARCH_MAX_RESULTS=5
BROWSER_SEARCH_HEADLESS=true
