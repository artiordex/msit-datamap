{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.formatOnSave": true,
  "kestra.api.url": "http://localhost:8080/api/v1",
  "kestra.api.tenant": "main",
  "kestra.schema.match-path": "flows",
  "yaml.validate": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.{yml,yaml}"
  },
  "files.associations": {
    "flows/*.yml": "yaml",
    "flows/*.yaml": "yaml"
  },
  "git.enabled": true,
  "git.autofetch": true
}
